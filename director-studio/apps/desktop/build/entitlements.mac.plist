<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements für App und Helfer (Hardened Runtime). electron-builder signiert damit die App (entitlements) und
  alle eingebetteten Programme (entitlementsInherit): Electron-Helfer, Remotion-Compositor samt ffmpeg/ffprobe und
  dylibs, esbuild, rspack-Binding und das optionale Claude-Code-Binary in resources/node_modules.
-->
<plist version="1.0">
  <dict>
    <!-- V8 (Electron) und JavaScriptCore im optionalen Claude-Code-Binary (Bun) brauchen JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!--
      Ad-hoc-signierter Code hat keine Team-ID; mit Library Validation verweigert dyld dann das Laden der
      Electron-Frameworks und der Compositor-dylibs („mapped file has no Team ID“). Bei Developer-ID-Signierung
      unschädlich, für lokale Builds nötig.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Push-to-Talk -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
