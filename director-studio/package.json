{
  "name": "director-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Lokale Desktop-Software: KI-Director (Claude) orchestriert fal.ai-Modelle für Video, Audio, Slides, Grafik und Web.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "app": "node apps/desktop/scripts/dev.mjs",
    "demo": "npm run -w @studio/desktop dev:web",
    "build": "node apps/desktop/scripts/build-main.mjs && npm run -w @studio/desktop build:renderer",
    "dist": "node apps/desktop/scripts/dist.mjs",
    "dist:dir": "node apps/desktop/scripts/dist.mjs --dir",
    "dist:mac": "node apps/desktop/scripts/dist.mjs --mac",
    "dist:win": "node apps/desktop/scripts/dist.mjs --win",
    "dist:test": "node apps/desktop/scripts/dist.mjs --dir --test-fuses",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run -w @studio/desktop test:e2e",
    "test:electron": "cd apps/desktop && playwright test -c e2e-electron/playwright.config.ts",
    "test:packaged": "cd apps/desktop && playwright test -c e2e-electron/playwright.packaged.config.ts",
    "extension:build": "npm run -w @studio/extension build",
    "extension:dev": "npm run -w @studio/extension dev",
    "extension:test": "npm run -w @studio/extension test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@anthropic-ai/sdk": "^0.131.0",
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/workers-types": "5.20261001.1",
    "@fal-ai/client": "^1.10.1",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@noble/hashes": "1.8.0",
    "@openai/mcp-extensions": "0.1.0",
    "@playwright/test": "^1.56.1",
    "@remotion/bundler": "^4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/player": "^4.0.532",
    "@remotion/renderer": "^4.0.532",
    "@remotion/web-renderer": "4.0.532",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "0.28.2",
    "fflate": "0.8.3",
    "html-to-image": "1.11.13",
    "jsdom": "^30.1.1",
    "mediabunny": "1.61.0",
    "pdf-lib": "1.17.1",
    "playwright": "^1.56.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "4.146.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
