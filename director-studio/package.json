{
  "name": "director-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Lokale Desktop-Software: KI-Director (Claude) orchestriert fal.ai-Modelle für Video, Audio, Slides, Grafik und Web.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "app": "node apps/desktop/scripts/dev.mjs",
    "demo": "npm run -w @studio/desktop dev:web",
    "build": "node apps/desktop/scripts/build-main.mjs && npm run -w @studio/desktop build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run -w @studio/desktop test:e2e",
    "test:electron": "cd apps/desktop && playwright test -c e2e-electron/playwright.config.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@anthropic-ai/sdk": "^0.131.0",
    "@fal-ai/client": "^1.10.1",
    "@playwright/test": "^1.56.1",
    "@remotion/bundler": "^4.0.532",
    "@remotion/player": "^4.0.532",
    "@remotion/renderer": "^4.0.532",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.56.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
